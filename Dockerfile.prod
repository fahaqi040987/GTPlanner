# Production Dockerfile for GTPlanner Backend
# Optimized for size, security, and performance

FROM python:3.11-slim

# Set environment variables for production
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CACHE_DIR=/app/.uv-cache \
    UV_LINK_MODE=copy \
    PYTHONOPTIMIZE=2

# Install only essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Install uv package manager
RUN pip install --no-cache-dir --no-python-version-warning uv

# Copy dependency files
COPY pyproject.toml ./
COPY uv.lock ./

# Install only production dependencies
RUN uv pip install --system --no-dev -r pyproject.toml

# Copy application code
COPY . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/database /app/backups && \
    chmod 755 /app/logs /app/database /app/backups

# Create non-root user for security
RUN useradd -m -u 1000 gtplanner && \
    chown -R gtplanner:gtplanner /app

# Switch to non-root user
USER gtplanner

# Expose port
EXPOSE 11211

# Production health check with more stringent requirements
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:11211/health')" || exit 1

# Production command
CMD ["python", "fastapi_main.py"]