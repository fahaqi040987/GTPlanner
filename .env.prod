# Production Environment Configuration
# Set these values for production deployment

# OpenAI API Configuration (Required)
LLM_API_KEY="${LLM_API_KEY}"
LLM_BASE_URL="${LLM_BASE_URL:-https://api.openai.com/v1}"
LLM_MODEL="${LLM_MODEL:-gpt-4}"

# Database Configuration (Required - use strong passwords)
POSTGRES_PASSWORD="${POSTGRES_PASSWORD}"
POSTGRES_DB="${POSTGRES_DB:-gtplanner_db}"
POSTGRES_USER="${POSTGRES_USER:-gtplanner}"

# Frontend Configuration (Required - set to production API URL)
VITE_API_BASE_URL="${VITE_API_BASE_URL}"

# Environment Settings
NODE_ENV=production
PYTHON_ENV=production
