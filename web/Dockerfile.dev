# Development Dockerfile for GTPlanner Frontend
# Optimized for hot module replacement (HMR) and development workflow

FROM node:20-slim

# Set working directory
WORKDIR /app

# Install package dependencies first
COPY package*.json ./

# Install dependencies with legacy peer deps to resolve conflicts
RUN npm install --legacy-peer-deps

# Copy application files
COPY . .

# Expose port for Vite dev server
EXPOSE 5173

# Development command with HMR
CMD ["npm", "run", "dev"]