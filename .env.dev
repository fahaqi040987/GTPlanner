# Development Environment Configuration
# Copy this file to .env.local and customize for local development

# OpenAI API Configuration
LLM_API_KEY="${LLM_API_KEY:-your-dev-api-key}"
LLM_BASE_URL="${LLM_BASE_URL:-https://api.openai.com/v1}"
LLM_MODEL="${LLM_MODEL:-gpt-4}"

# Database Configuration
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-dev_password}"
POSTGRES_DB="${POSTGRES_DB:-gtplanner_db}"
POSTGRES_USER="${POSTGRES_USER:-gtplanner}"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:11211"

# Environment Settings
NODE_ENV=development
PYTHON_ENV=development
